# ArchPilot Configuration

PROJECT_NAME="ArchPilot"
VERSION="0.1.0"
ENV="development"
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# Database Configuration (SQLite default for Phase 1)
DATABASE_URL="sqlite:///./archpilot.db"

# LLM Provider Configuration ("mock", "ollama", "openai_compatible")
LLM_PROVIDER="mock"

# Ollama Settings (Optional, when LLM_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"

# OpenAI-Compatible Settings (Optional, when LLM_PROVIDER="openai_compatible")
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Guardrails and Limits
MAX_TASK_LENGTH=4000
MAX_STEPS=6
MAX_TOOL_RETRIES=2
MAX_VALIDATION_RETRIES=2
